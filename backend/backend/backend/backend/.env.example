# Copie ce fichier en ".env" (jamais commité) et remplis tes propres valeurs.

# Port local du serveur
PORT=3001

# Choix du moteur IA : "gemini" (gratuit, par défaut) ou "claude"
LLM_PROVIDER=gemini

# Clé Gemini gratuite — générée sur https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clé Anthropic — à ajouter uniquement quand tu passeras LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# Chaîne de connexion Supabase (Settings > Database > Connection string > URI)
DATABASE_URL=

# Clé Tavily gratuite (recherche web/entreprises) — générée sur tavily.com, sans carte bancaire
TAVILY_API_KEY=

# Clé de chiffrement des tokens de réseaux sociaux (32 octets hex) — génère avec: openssl rand -hex 32
ENCRYPTION_KEY=

# Stockage fichiers Supabase (optionnel — nécessaire pour l'upload réel de fichiers)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# OAuth Meta (Facebook/Instagram) — depuis developers.facebook.com, app en mode développement
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=

# OAuth Google (YouTube) — depuis console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Active le scheduler d'automatisations (cron) — n'a d'effet réel que si le
# serveur tourne en continu (déploiement). Laisser à false en local/dev.
AUTOMATIONS_ENABLED=false
